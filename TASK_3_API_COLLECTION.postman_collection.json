{
  "info": {
    "name": "Task 3 - API Collection",
    "description": "Postman collection for Task 3 flows: auth, merchant registration/approval, product publish, storefront, cart, order, courier approval/status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminEmail", "value": "admin@vhandelivery.com" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "merchantOwnerEmail", "value": "merchant_owner_1@example.com" },
    { "key": "merchantOwnerPassword", "value": "Password123!" },
    { "key": "merchantOwnerAccessToken", "value": "" },
    { "key": "customerEmail", "value": "customer_1@example.com" },
    { "key": "customerPassword", "value": "Password123!" },
    { "key": "customerAccessToken", "value": "" },
    { "key": "courierEmail", "value": "courier_1@example.com" },
    { "key": "courierPassword", "value": "Password123!" },
    { "key": "courierAccessToken", "value": "" },
    { "key": "merchantPhone", "value": "0980000000" },
    { "key": "otpCode", "value": "" },
    { "key": "verificationToken", "value": "" },
    { "key": "merchantExternalId", "value": "" },
    { "key": "merchantId", "value": "" },
    { "key": "productExternalId", "value": "" },
    { "key": "courierId", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/register (merchant owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('merchantOwnerAccessToken', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{merchantOwnerEmail}}\",\n  \"password\": \"{{merchantOwnerPassword}}\",\n  \"username\": \"merchant_owner_1\",\n  \"phone\": \"0900000000\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "POST /auth/register (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('customerAccessToken', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"username\": \"customer_1\",\n  \"phone\": \"0900000001\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "POST /auth/register (courier)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('courierAccessToken', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{courierEmail}}\",\n  \"password\": \"{{courierPassword}}\",\n  \"username\": \"courier_1\",\n  \"phone\": \"0900000002\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        }
      ]
    },
    {
      "name": "Merchant",
      "item": [
        {
          "name": "POST /merchants/otp/request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{merchantPhone}}\"\n}"
            },
            "url": "{{baseUrl}}/merchants/otp/request"
          }
        },
        {
          "name": "POST /merchants/otp/verify",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('verificationToken', json.verificationToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{merchantPhone}}\",\n  \"code\": \"{{otpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/merchants/otp/verify"
          }
        },
        {
          "name": "POST /merchants/register (self-register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('merchantExternalId', json.externalId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{merchantOwnerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Merchant\",\n  \"phone\": \"{{merchantPhone}}\",\n  \"verificationToken\": \"{{verificationToken}}\",\n  \"address\": \"123 Test St\",\n  \"city\": \"HCM\",\n  \"contactName\": \"Owner\",\n  \"businessType\": \"ONLINE\",\n  \"businessCategory\": \"FOOD\",\n  \"hasBusinessLicense\": false\n}"
            },
            "url": "{{baseUrl}}/merchants/register"
          }
        },
        {
          "name": "PATCH /merchants/:externalId/status (admin approve)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": "{{baseUrl}}/merchants/{{merchantExternalId}}/status"
          }
        },
        {
          "name": "GET /merchants/:externalId (get numeric merchantId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('merchantId', String(json.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{merchantOwnerAccessToken}}" }],
            "url": "{{baseUrl}}/merchants/{{merchantExternalId}}"
          }
        }
      ]
    },
    {
      "name": "Product",
      "item": [
        {
          "name": "POST /products (create DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('productExternalId', json.externalId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{merchantOwnerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"name\": { \"vi\": \"Banh mi\" },\n  \"description\": { \"vi\": \"Ngon\" },\n  \"price\": 100,\n  \"sku\": \"SKU-POSTMAN-1\",\n  \"stock\": 10,\n  \"status\": \"DRAFT\"\n}"
            },
            "url": "{{baseUrl}}/products?merchantId={{merchantId}}"
          }
        },
        {
          "name": "PATCH /products/:externalId (publish)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{merchantOwnerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": "{{baseUrl}}/products/{{productExternalId}}"
          }
        }
      ]
    },
    {
      "name": "Storefront (B2C)",
      "item": [
        {
          "name": "GET /storefront/products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": "{{baseUrl}}/storefront/products?page=1&limit=10"
          }
        },
        {
          "name": "GET /storefront/products/:externalId",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": "{{baseUrl}}/storefront/products/{{productExternalId}}"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "POST /carts/merchant/:merchantId/items",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productExternalId\": \"{{productExternalId}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/carts/merchant/{{merchantId}}/items"
          }
        },
        {
          "name": "GET /carts/merchant/:merchantId",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": "{{baseUrl}}/carts/merchant/{{merchantId}}"
          }
        }
      ]
    },
    {
      "name": "Order",
      "item": [
        {
          "name": "POST /orders/merchant/:merchantId (create from cart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('orderId', String(json.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddress\": {\n    \"name\": \"Customer\",\n    \"phone\": \"0900000001\",\n    \"addressLine\": \"456 Customer St\"\n  }\n}"
            },
            "url": "{{baseUrl}}/orders/merchant/{{merchantId}}"
          }
        }
      ]
    },
    {
      "name": "Courier",
      "item": [
        {
          "name": "PATCH /couriers/:id/approve (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approvalStatus\": \"APPROVED\"\n}"
            },
            "url": "{{baseUrl}}/couriers/{{courierId}}/approve"
          }
        },
        {
          "name": "PATCH /couriers/me/status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{courierAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"onlineStatus\": \"ONLINE\"\n}"
            },
            "url": "{{baseUrl}}/couriers/me/status"
          }
        },
        {
          "name": "PATCH /couriers/me/location",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{courierAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 10.0,\n  \"longitude\": 10.0\n}"
            },
            "url": "{{baseUrl}}/couriers/me/location"
          }
        }
      ]
    }
  ]
}
